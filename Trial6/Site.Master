<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Trial6.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Online Exam Portal</title>
    <!-- Simple Bootstrap for styling (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        body { padding-top: 70px; }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-md navbar-dark bg-dark fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">ExamPortal</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <!-- We will control visibility in Code Behind -->
                        <li class="nav-item">
                            <a class="nav-link" href="/Student/Dashboard.aspx" id="lnkStudent" runat="server" visible="false">My Exams</a>
                        </li>
                    </ul>
                    <span class="navbar-text text-white">
                        <asp:Label ID="lblUsername" runat="server" Text=""></asp:Label>
                    </span>
                    <asp:Button ID="btnLogout" runat="server" Text="Logout" CssClass="btn btn-outline-danger btn-sm ms-3" OnClick="btnLogout_Click" />
                </div>
            </div>
        </nav>

        <!-- Main Content Area (Where pages get injected) -->
        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>